# TiDB connection (from your TiDB Cloud cluster's "Connect" dialog)
TIDB_HOST=gateway01.xx-xxxxx.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=xxxxxxxx.root
TIDB_PASSWORD=your-password
TIDB_DATABASE=bahi

# Required: long random secret used to sign login tokens.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Required in production: your deployed frontend origin(s), comma-separated.
# Requests from any other origin will be rejected by CORS.
FRONTEND_URL=http://localhost:5173

# AI Advisor — at least one of these providers is required.
# Each provider also accepts an optional fallback key (tried if the primary
# key fails/is rate-limited, before moving on to the next provider):
GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
GROQ_API_KEY=
GROQ_API_KEY_2=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: only needed if your fallback Cloudflare token belongs to a
# different account than CLOUDFLARE_ACCOUNT_ID above.
CLOUDFLARE_ACCOUNT_ID_2=
CLOUDFLARE_API_TOKEN_2=

# Password reset emails — optional but required for "Forgot password" to
# actually send an email. Without it, reset links are just logged to the
# server console (fine for local dev, not for real users).
# Sign up free at resend.com, verify a sending domain (or use their sandbox
# address below for testing).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Bahi <onboarding@resend.dev>
