# Server
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000
NODE_ENV=development

# URL where the FRONTEND is hosted (Netlify, etc). Required for CORS and
# for redirecting back to the app after Instagram OAuth completes.
# No trailing slash. e.g. https://tally-app.netlify.app
FRONTEND_URL=http://localhost:5173

# Meta / Instagram Graph API
# Create app: https://developers.facebook.com/apps/
# Add "Instagram Graph API" product. Use these scopes: instagram_basic, pages_show_list.
# OAuth redirect URI to register in the app: <this backend's URL>/api/instagram/callback
IG_CLIENT_ID=
IG_CLIENT_SECRET=
IG_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# SMTP (Gmail example uses an App Password: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Tally <no-reply@example.com>"
